<Window x:Class="Aeris.NumberDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Number.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock x:Name="Prompt" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBox x:Name="Input" FontSize="17" Padding="10" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" AutomationProperties.Name="{DynamicResource Number.Title}"/>
    <TextBlock x:Name="Error" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Margin="0,0,8,0"/><Button Content="{DynamicResource Number.Apply}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Apply"/></StackPanel>
  </StackPanel>
</Window>
