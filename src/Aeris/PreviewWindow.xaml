<Window x:Class="Aeris.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="740" MinWidth="880" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" Title="{DynamicResource Preview.Window}">
  <Grid Margin="28,24,28,20" TextElement.Foreground="{DynamicResource Ink}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="Subheading" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
    </StackPanel>
    <Border x:Name="WarningBox" Grid.Row="1" Background="{DynamicResource ProgressSurface}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Data="M12 3 L22 20 H2 Z M12 10 V14 M12 17 V17.5" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,12,0"/>
        <TextBlock x:Name="Warnings" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Preview.Categories}" Style="{StaticResource Caption}" Margin="20,18,20,10"/>
          <ListBox x:Name="CategoryList" Grid.Row="1" SelectionMode="Single" SelectionChanged="CategoryChanged" AutomationProperties.Name="{DynamicResource Preview.Categories}" Padding="0,0,0,8">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" Click="CategoryToggled" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="8,8,8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="Search" TextChanged="SearchChanged" Padding="34,10,10,10" FontSize="13" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Preview.Search}"/>
              <Path Data="M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 M15 15 L21 21" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
              <TextBlock Text="{DynamicResource Preview.Search}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox x:Name="SortOrder" Grid.Column="1" Width="170" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="SortChanged" AutomationProperties.Name="{DynamicResource Preview.Sort}">
              <ComboBoxItem Content="{DynamicResource Preview.SortSize}"/><ComboBoxItem Content="{DynamicResource Preview.SortName}"/><ComboBoxItem Content="{DynamicResource Preview.SortDate}"/>
            </ComboBox>
            <Button Grid.Column="2" Content="{DynamicResource Preview.IncludeShown}" Click="IncludeShown" Margin="10,0,0,0"/>
            <Button Grid.Column="3" Content="{DynamicResource Preview.ExcludeShown}" Click="ExcludeShown" Margin="10,0,0,0"/>
          </Grid>
          <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" CanUserResizeRows="False" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" RowHeight="40" Background="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Field}" SelectionMode="Extended" HorizontalScrollBarVisibility="Disabled" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewKeyDown="GridKeyDown" MouseDoubleClick="RevealItem">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="ItemToggled" AutomationProperties.Name="{Binding Name}" MinHeight="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Name}" Width="2*" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.File}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding DisplaySize}" Width="100" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Size}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding DisplayModified}" Width="165" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Modified}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Directory}" Width="3*" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Location}"/></DataGridTextColumn.Header></DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock x:Name="Totals" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ModeHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="ModePicker" Width="200" Margin="0,0,10,0" SelectionChanged="ModeChanged" AutomationProperties.Name="{DynamicResource Preview.Mode}" Visibility="Collapsed">
          <ComboBoxItem Tag="Permanent" Content="{DynamicResource Mode.Permanent}"/><ComboBoxItem Tag="Quarantine" Content="{DynamicResource Mode.Quarantine}"/>
        </ComboBox>
        <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Margin="0,0,10,0"/>
        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="Confirm"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
