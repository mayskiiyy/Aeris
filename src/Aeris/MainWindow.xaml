              <WrapPanel Margin="0,10,0,0"><Button x:Name="AddProtectedButton" Content="{DynamicResource Settings.AddFolder}" Click="AddFolderSetting" Tag="Protected" Margin="0,0,10,0"/><Button x:Name="RemoveProtectedButton" Content="{DynamicResource Settings.RemoveFolder}" Click="RemoveFolderSetting" Tag="Protected"/></WrapPanel>
              <CheckBox x:Name="SequentialSetting" Content="{DynamicResource Settings.Sequential}" Click="CleanupSettingChanged" Margin="0,16,0,0" ToolTip="{DynamicResource Settings.SequentialHint}"/>
              <DockPanel Margin="0,8,0,0"><Button x:Name="ClearHashCacheButton" Content="{DynamicResource Settings.ClearHashCache}" Click="ClearHashCache" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="HashCacheInfo" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="{DynamicResource Settings.Automation}" Style="{StaticResource Caption}"/>
              <CheckBox x:Name="ScheduleEnabled" Content="{DynamicResource Schedule.Enable}" Margin="0,10,0,0" Click="ScheduleToggled"/>
              <TextBlock Text="{DynamicResource Schedule.Hint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12" LineHeight="18"/>
              <WrapPanel x:Name="SchedulePanel">
                <ComboBox x:Name="ScheduleFrequency" Width="170" Margin="0,0,10,8" AutomationProperties.Name="{DynamicResource Schedule.Frequency}" ToolTip="{DynamicResource Schedule.Frequency}">
                  <ComboBoxItem Tag="Daily" Content="{DynamicResource Schedule.Daily}"/><ComboBoxItem Tag="Weekly" Content="{DynamicResource Schedule.Weekly}"/><ComboBoxItem Tag="Monthly" Content="{DynamicResource Schedule.Monthly}"/>
                </ComboBox>
                <ComboBox x:Name="ScheduleHour" Width="110" Margin="0,0,10,8" AutomationProperties.Name="{DynamicResource Schedule.Time}" ToolTip="{DynamicResource Schedule.Time}"/>
                <ComboBox x:Name="ScheduleAge" Width="190" Margin="0,0,10,8" AutomationProperties.Name="{DynamicResource Caches.Retention}" ToolTip="{DynamicResource Caches.OlderThan}">
                  <ComboBoxItem Tag="2"/><ComboBoxItem Tag="7"/><ComboBoxItem Tag="14"/><ComboBoxItem Tag="30"/>
                </ComboBox>
                <ComboBox x:Name="ScheduleMode" Width="210" Margin="0,0,10,8" AutomationProperties.Name="{DynamicResource Settings.Mode}" ToolTip="{DynamicResource Settings.Mode}">
                  <ComboBoxItem Tag="Quarantine" Content="{DynamicResource Mode.Quarantine}"/><ComboBoxItem Tag="Permanent" Content="{DynamicResource Mode.Permanent}"/>
                </ComboBox>
                <Button x:Name="ScheduleSaveButton" Content="{DynamicResource Schedule.Save}" Click="SaveSchedule" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
              </WrapPanel>
              <TextBlock x:Name="ScheduleStatus" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12"/>
              <CheckBox x:Name="ShellMenuEnabled" Content="{DynamicResource Shell.Enable}" Click="ShellMenuToggled"/>
              <TextBlock Text="{DynamicResource Shell.Hint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="{DynamicResource Settings.Rules}" Style="{StaticResource Caption}"/>
              <TextBlock Text="{DynamicResource Settings.RulesHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10" LineHeight="18"/>
              <DockPanel><Button Content="{DynamicResource Rules.OpenFolder}" Click="OpenRulesFolder" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="RulesInfo" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/></DockPanel>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem x:Name="HelpTab"><TabItem.Header><DockPanel><Path Style="{StaticResource NavigationIcon}" Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M9 9 C9 5 16 5 16 9 C16 12 12 11 12 15 M12 17 V18"/><TextBlock Text="{DynamicResource Nav.Help}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
        <ScrollViewer x:Name="HelpScroll" Focusable="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Nav.Help}">
          <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Nav.Help}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Help.Intro}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Help.StartTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.Start}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Nav.Caches}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.Cache}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Desktop.Disk}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.DiskWindows}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Nav.Duplicates}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.DuplicatesWindows}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Nav.History}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.Recovery}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Nav.Settings}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.SettingsWindows}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Help.TroubleTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.Trouble}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="{DynamicResource Help.KeysTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Help.Keys}" TextWrapping="Wrap" LineHeight="23"/><TextBlock Text="{DynamicResource Help.MouseWindows}" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,0"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.RowSpan="2" VerticalAlignment="Top" Margin="22,28,14,0" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource Logo}" Width="34" Height="34" AutomationProperties.Name="{DynamicResource Sidebar.Logo}"/><TextBlock Text="Aeris" Foreground="#F3FAF5" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
      <TextBlock Text="{DynamicResource Sidebar.Section}" Foreground="#9DB9A9" FontSize="10" FontWeight="SemiBold" Margin="3,44,0,0"/>
    </StackPanel>
    <StackPanel Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="16,0,16,22">
      <Button x:Name="DriveButton" Background="#203B2C" BorderBrush="Transparent" Padding="14" HorizontalContentAlignment="Stretch" Click="OpenDriveMenu" ToolTip="{DynamicResource Drive.Choose}" AutomationProperties.Name="{DynamicResource Drive.Choose}">
        <StackPanel><DockPanel><Path DockPanel.Dock="Right" Data="M0 5 L4 1 L8 5" Stroke="#B4CDBD" StrokeThickness="1.5" Width="8" Height="5" VerticalAlignment="Center"/><TextBlock x:Name="DriveLabel" Foreground="#B4CDBD" FontSize="10" FontWeight="Normal"/></DockPanel><TextBlock x:Name="DiskSpace" Text="—" Foreground="#EEFAF3" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="{DynamicResource Sidebar.Free}" Foreground="#B4CDBD" FontSize="12" FontWeight="Normal"/><ProgressBar x:Name="DiskBar" Height="4" Foreground="#A1E2BC" Background="#40604C" BorderThickness="0" Margin="0,14,0,10"/><TextBlock x:Name="DiskDetail" Foreground="#B4CDBD" FontSize="10" FontWeight="Normal" TextWrapping="Wrap"/></StackPanel>
      </Button>
    </StackPanel>
    <Popup x:Name="DrivePopup" PlacementTarget="{Binding ElementName=DriveButton}" Placement="Top" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="True" Closed="DriveMenuClosed">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8" Width="300" PreviewKeyDown="DrivePopupKeyDown" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel><TextBlock Text="{DynamicResource Drive.MenuTitle}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="10,8,10,12"/><TextBlock x:Name="DriveLoading" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0,10,10"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="310"><ItemsControl x:Name="DriveChoices"><ItemsControl.ItemTemplate><DataTemplate>
          <Button Tag="{Binding}" Click="SelectDrive" IsEnabled="{Binding Ready}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,5" BorderBrush="Transparent">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Margin="0,6,0,0"/><ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0" Margin="0,8,0,0"/></StackPanel><Path Grid.Column="1" Data="M2 8 L6 12 L14 3" Stroke="{DynamicResource Accent}" StrokeThickness="2" Width="16" Height="14" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
      </Border>
    </Popup>
    <Border x:Name="CacheSearchBox" Grid.Column="1" VerticalAlignment="Top" Margin="28,20,200,0" MaxWidth="400" Height="42" CornerRadius="10" Background="{DynamicResource Field}" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, ElementName=CacheTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      </Style.Triggers></Style></Border.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
        <Path Data="M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 M15 15 L21 21" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="17" Height="17" Stretch="Uniform" IsHitTestVisible="False"/>
        <TextBox Grid.Column="1" x:Name="CacheSearch" TextChanged="CacheSearchChanged" PreviewKeyDown="CacheSearchKeyDown" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="0,8" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Caches.Search}" ToolTip="{DynamicResource Caches.SearchHint}">
          <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Background="Transparent"/></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock Grid.Column="1" Text="{DynamicResource Caches.Search}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CacheSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button Grid.Column="2" Click="ClearCacheSearch" Padding="7" Margin="2,3" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{DynamicResource Caches.ClearSearch}" ToolTip="{DynamicResource Caches.ClearSearch}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CacheSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><Path Data="M4 4 L14 14 M14 4 L4 14" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/></Button>
      </Grid>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,28,0">
      <ComboBox x:Name="LanguagePicker" Width="100" Height="42" Margin="0,0,10,0" SelectionChanged="LanguageChanged" ToolTip="{DynamicResource Language.Label}" AutomationProperties.Name="{DynamicResource Language.Label}">
        <ComboBox.ItemTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Path x:Name="Globe" Visibility="Collapsed" Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3 12 H21 M12 3 Q6.5 12 12 21 M12 3 Q17.5 12 12 21" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center"/>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
              <Setter TargetName="Label" Property="Text" Value="{Binding Tag}"/><Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Globe" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="ThemeButton" Width="42" Height="42" Padding="10" Click="SwitchTheme">
        <Path x:Name="ThemeGlyph" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/>
      </Button>
    </StackPanel>
    <Border x:Name="StatusBar" Visibility="Collapsed" Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="28,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><ProgressBar x:Name="Activity" Height="2" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Common.Cancel}" Click="CancelScan" Visibility="Collapsed" Margin="12,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
