<Window x:Class="Aeris.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aeris"
        Title="Aeris" Icon="Assets/aeris.ico" Width="1280" Height="880" MinWidth="960" MinHeight="700" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" PreviewMouseDown="DismissDrivePopup" PreviewKeyDown="WindowSearchKeyDown">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,200,24"/>
    </Style>
    <Style x:Key="ActionIcon" TargetType="Path">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/><Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="ActionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ActionHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <EventSetter Event="Click" Handler="HomeAction"/>
      <Setter Property="Padding" Value="20"/><Setter Property="MinHeight" Value="112"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="#14291F"/>
    <TabControl x:Name="MainTabs" Grid.ColumnSpan="2" SelectedIndex="0" TabStripPlacement="Left" BorderThickness="0" SelectionChanged="TabChanged">
      <TabItem x:Name="HomeTab"><TabItem.Header><DockPanel><Path Style="{StaticResource NavigationIcon}" Data="M3 10 L12 3 L21 10 M5 9 V21 H10 V15 H14 V21 H19 V9"/><TextBlock Text="{DynamicResource Nav.Home}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Home.Title}" Style="{StaticResource PageTitle}"/>
            <StackPanel Margin="0,0,0,24">
              <TextBlock Text="{DynamicResource Search.Title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="HomeSearch" TextChanged="HomeSearchChanged" PreviewKeyDown="HomeSearchKeyDown" AutomationProperties.Name="{DynamicResource Search.Title}" ToolTip="{DynamicResource Search.Hint}" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" Padding="12,10" VerticalContentAlignment="Center"/>
                <TextBlock Text="{DynamicResource Search.Hint}" Foreground="{DynamicResource Muted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HomeSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="{DynamicResource Search.Clear}" Click="ClearHomeSearch" Margin="10,0,0,0"/>
              </Grid>
              <Border x:Name="HomeSearchPanel" Visibility="Collapsed" ClipToBounds="True" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8">
                <StackPanel>
                  <TextBlock x:Name="HomeSearchSummary" Foreground="{DynamicResource Muted}" Margin="8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
                    <ItemsControl x:Name="HomeSearchResults" AutomationProperties.Name="{DynamicResource Search.Results}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Click="OpenHomeSearchResult" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12" AutomationProperties.Name="{Binding Title}">
                          <StackPanel TextElement.FontWeight="Normal"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,5,0,0"/></StackPanel>
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </StackPanel>
            <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="{DynamicResource Home.FreeSpace}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Text, ElementName=DiskSpace}" FontSize="38" FontWeight="SemiBold" Margin="0,8,0,12"/><ProgressBar Value="{Binding Value, ElementName=DiskBar}" Height="6" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"/><TextBlock Text="{Binding Text, ElementName=DiskDetail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><Button x:Name="HomeCacheCard" Tag="cache-view" Click="HomeAction" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource Nav.Caches}" AutomationProperties.Name="{DynamicResource Nav.Caches}"><StackPanel><TextBlock x:Name="HomeCacheTitle" Text="{DynamicResource Home.Caches}" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HomeCacheSize" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,14"/><TextBlock x:Name="HomeCacheHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Button></Border>
            </Grid>
            <TextBlock Text="{DynamicResource Home.QuickActions}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button x:Name="HomeCacheAction" Grid.Column="0" Grid.Row="0" Tag="cache" Style="{StaticResource ActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M3 6 H9 L11 8 H21 V20 H3 Z M3 6 V4 H9 L11 6" Style="{StaticResource ActionIcon}"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Caches.Check}" Style="{StaticResource ActionTitle}"/><TextBlock Text="{DynamicResource Home.CheckCachesHint}" Style="{StaticResource ActionHint}"/></StackPanel></Grid></Button>
              <Button Grid.Column="2" Grid.Row="0" Tag="files" Style="{StaticResource ActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M5 2 H14 L20 8 V22 H5 Z M14 2 V8 H20 M9 12 H16 M9 16 H16" Style="{StaticResource ActionIcon}"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Home.FindLarge}" Style="{StaticResource ActionTitle}"/><TextBlock Text="{DynamicResource Home.FindLargeHint}" Style="{StaticResource ActionHint}"/></StackPanel></Grid></Button>
              <Button Grid.Column="0" Grid.Row="2" Tag="map" Style="{StaticResource ActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M3 3 H13 V11 H3 Z M16 3 H21 V15 H16 Z M3 14 H13 V21 H3 Z M16 18 H21 V21 H16 Z" Style="{StaticResource ActionIcon}"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Home.Map}" Style="{StaticResource ActionTitle}"/><TextBlock Text="{DynamicResource Home.MapHint}" Style="{StaticResource ActionHint}"/></StackPanel></Grid></Button>
              <Button Grid.Column="2" Grid.Row="2" Tag="duplicates" Style="{StaticResource ActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M8 8 H21 V21 H8 Z M4 16 H3 V3 H16 V4" Style="{StaticResource ActionIcon}"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Home.Duplicates}" Style="{StaticResource ActionTitle}"/><TextBlock Text="{DynamicResource Home.DuplicatesHint}" Style="{StaticResource ActionHint}"/></StackPanel></Grid></Button>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,26,0,0"><DockPanel><Button Content="{DynamicResource Nav.History}" Tag="history" DockPanel.Dock="Right" Click="HomeAction" Margin="12,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Home.LastOperation}" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="HomeLastAction" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="CacheTab"><TabItem.Header><DockPanel><Path Style="{StaticResource NavigationIcon}" Data="M3 6 H9 L11 8 H21 V20 H3 Z M3 6 V4 H9 L11 6"/><TextBlock Text="{DynamicResource Nav.Caches}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
        <Grid TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal" Margin="0,52,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Home.Caches}" Style="{StaticResource PageTitle}"/>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource Caches.OlderThan}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ComboBox x:Name="Retention" Grid.Column="1" Width="150" ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Caches.Retention}" SelectionChanged="RetentionChanged">
                <ComboBoxItem Tag="2"/><ComboBoxItem Tag="7"/><ComboBoxItem Tag="30"/><ComboBoxItem Tag="custom"/>
              </ComboBox>
              <Button x:Name="CacheScanButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="RefreshCaches" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Background="{DynamicResource ProgressSurface}" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsIndeterminate, ElementName=Activity}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel><TextBlock Text="{Binding Text, ElementName=Status}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ScanLocation" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="ScanFile" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsIndeterminate, ElementName=Activity}" Foreground="{DynamicResource Accent}" Background="{DynamicResource ProgressTrack}" BorderThickness="0"/></StackPanel>
          </Border>
          <Border x:Name="RuleNotice" Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed"><DockPanel><Button Content="{DynamicResource Rules.OpenFolder}" Click="OpenRulesFolder" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{DynamicResource Rules.Skipped}" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="RuleErrors" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="72"/></StackPanel></DockPanel></Border>
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="20,16,20,8">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{DynamicResource Caches.Category}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="CacheCategory" SelectedIndex="0" SelectionChanged="CacheFilterChanged" AutomationProperties.Name="{DynamicResource Caches.Category}"><ComboBoxItem Tag="" Content="{DynamicResource Caches.AllCategories}"/><ComboBoxItem Tag="Windows" Content="{DynamicResource CacheGroup.Windows}"/><ComboBoxItem Tag="Browsers" Content="{DynamicResource CacheGroup.Browsers}"/><ComboBoxItem Tag="Apps" Content="{DynamicResource CacheGroup.Apps}"/><ComboBoxItem Tag="GamesAndGpu" Content="{DynamicResource CacheGroup.GamesAndGpu}"/><ComboBoxItem Tag="Developer" Content="{DynamicResource CacheGroup.Developer}"/><ComboBoxItem Tag="Custom" Content="{DynamicResource CacheGroup.Custom}"/></ComboBox></StackPanel>
                  </Grid>
                  <TextBlock x:Name="CacheFilterSummary" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                  <Grid Margin="0,14,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Caches.Categories}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{DynamicResource Caches.ToClean}" Style="{StaticResource Caption}"/></Grid>
                </StackPanel>
                <ListBox x:Name="CacheList" Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="{DynamicResource Caches.List}" SelectionChanged="CacheDetailChanged" Padding="0,0,0,8" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                  <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="20,14,20,4"/>
                  </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid Background="Transparent" MouseLeftButtonUp="CacheRowClicked" Cursor="Hand"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" ToolTip="{DynamicResource Caches.SelectTip}" Checked="CacheSelectionChanged" Unchecked="CacheSelectionChanged" Margin="0,0,8,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Border HorizontalAlignment="Left" CornerRadius="5" Padding="7,2" Margin="0,7,0,0" BorderThickness="1" BorderBrush="{DynamicResource SelectedLine}" Background="{DynamicResource Selected}" ToolTip="{Binding RiskHint}">
                          <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSafe}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                          <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SelectedText}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding EligibleText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding TotalText}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
              <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Width="{Binding ViewportWidth, ElementName=DetailScroll}" DataContext="{Binding SelectedItem, ElementName=CacheList}">
                  <TextBlock Text="{DynamicResource Caches.About}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,12"/>
                  <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                  <TextBlock Text="{DynamicResource Caches.Where}" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                  <TextBlock Text="{Binding FriendlyLocation}" FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20"/>
                  <Expander x:Name="RootExpander" Header="{Binding RootsTitle}" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Ink}">
                    <TextBox Foreground="{DynamicResource Ink}" Text="{Binding RootsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="{DynamicResource FieldSoft}" Padding="8" Margin="0,8,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Caches.ExactFolders}"/>
                  </Expander>
                  <TextBlock Text="{DynamicResource Caches.Risk}" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                  <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20"><Run Text="{Binding RiskText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding RiskHint, Mode=OneWay}" Foreground="{DynamicResource Muted}"/></TextBlock>
                  <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Grid Grid.Row="5" Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="SelectionSummary" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CleanModeHint" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SelectAllButton" Click="SelectAllCaches" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="CleanButton" Content="{DynamicResource Caches.CleanSelected}" Style="{StaticResource PrimaryButton}" Click="CleanSelected" IsEnabled="False"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="FilesTab"><TabItem.Header><DockPanel><Path Style="{StaticResource NavigationIcon}" Data="M5 2 H14 L20 8 V22 H5 Z M14 2 V8 H20 M9 12 H16 M9 16 H16"/><TextBlock Text="{DynamicResource Nav.Files}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
        <Grid TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,22"><TextBlock Text="{DynamicResource Files.Title}" Style="{StaticResource PageTitle}" Margin="0,6,200,6"/><ComboBox x:Name="FileType" Width="240" HorizontalAlignment="Left" SelectedIndex="0" Margin="0,8,0,0" SelectionChanged="TypeChanged" AutomationProperties.Name="{DynamicResource Files.Type}"><ComboBoxItem Content="{DynamicResource Type.All}"/><ComboBoxItem Content="{DynamicResource Type.Video}"/><ComboBoxItem Content="{DynamicResource Type.Archives}"/><ComboBoxItem Content="{DynamicResource Type.Installers}"/><ComboBoxItem Content="{DynamicResource Type.Documents}"/><ComboBoxItem Content="{DynamicResource Type.Images}"/></ComboBox></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Files.FolderCaption}" Style="{StaticResource Caption}"/><TextBlock x:Name="FolderLabel" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
              <Button x:Name="ChooseButton" Grid.Column="1" Content="{DynamicResource Common.Choose}" Click="ChooseFolder" Margin="0,0,10,0"/>
              <ComboBox x:Name="Threshold" Grid.Column="2" Width="150" ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}" SelectedIndex="1" AutomationProperties.Name="{DynamicResource Files.MinSize}" SelectionChanged="ThresholdChanged" Margin="0,0,10,0">
                <ComboBoxItem Tag="10"/><ComboBoxItem Tag="100"/><ComboBoxItem Tag="500"/><ComboBoxItem Tag="1024"/><ComboBoxItem Tag="5120"/><ComboBoxItem Tag="custom"/>
              </ComboBox>
              <Button x:Name="ScanButton" Grid.Column="3" Content="{DynamicResource Common.Scan}" Style="{StaticResource PrimaryButton}" Click="StartScan"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" RowHeight="48" Background="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Field}" SelectionMode="Extended" HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RevealFile">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Width="2*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.File}"/></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding DisplaySize}" Width="110" SortMemberPath="Size"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Size}"/></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Directory}" Width="3*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Location}"/></DataGridTextColumn.Header></DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,12,0,16"><TextBlock x:Name="FilesHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button x:Name="ExportButton" Content="{DynamicResource Files.SaveCsv}" Click="SaveCsv" IsEnabled="False" Margin="0,0,10,4"/><Button Content="{DynamicResource Common.ShowInExplorer}" Click="RevealFile" Margin="0,0,10,4"/><Button x:Name="TrashFilesButton" Content="{DynamicResource Common.MoveToRecycle}" Click="TrashSelected" IsEnabled="False" Margin="0,0,0,4"/></WrapPanel></StackPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="MapTab"><TabItem.Header><DockPanel><Path Style="{StaticResource NavigationIcon}" Data="M3 3 H13 V11 H3 Z M16 3 H21 V15 H16 Z M3 14 H13 V21 H3 Z M16 18 H21 V21 H16 Z"/><TextBlock Text="{DynamicResource Nav.Map}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
        <Grid TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Nav.Map}" Style="{StaticResource PageTitle}"/>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><DockPanel>
            <Button x:Name="MapScanButton" DockPanel.Dock="Right" Content="{DynamicResource Common.Scan}" Click="StartScan" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
            <Button x:Name="MapChooseButton" DockPanel.Dock="Right" Content="{DynamicResource Common.Choose}" Click="ChooseFolder" Margin="10,0,0,0"/>
            <ComboBox x:Name="SizeMode" DockPanel.Dock="Right" Width="190" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="SizeModeChanged" AutomationProperties.Name="{DynamicResource Map.SizeMode}" ToolTip="{DynamicResource Map.SizeModeHint}">
              <ComboBoxItem Content="{DynamicResource Map.Logical}"/><ComboBoxItem Content="{DynamicResource Map.OnDisk}"/>
            </ComboBox>
            <TextBlock x:Name="MapFolder" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </DockPanel></Border>
          <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="MapUpButton" DockPanel.Dock="Left" Click="MapUp" IsEnabled="False" Padding="10,6" MinHeight="34" Margin="0,0,10,0" ToolTip="{DynamicResource Map.Up}" AutomationProperties.Name="{DynamicResource Map.Up}">
              <Path Data="M12 19 V5 M5 12 L12 5 L19 12" Stroke="{DynamicResource Ink}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
            </Button>
            <ItemsControl x:Name="Breadcrumbs" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="Separator" Text="›" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,4,0"/>
