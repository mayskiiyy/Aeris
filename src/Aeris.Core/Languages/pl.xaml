  <s:String x:Key="Caches.NoMatches">Brak wyników. Zmień kategorię lub zapytanie.</s:String>
  <s:String x:Key="Caches.SelectVisible">Zaznacz widoczne</s:String>
  <s:String x:Key="Caches.ClearVisible">Odznacz widoczne</s:String>
  <s:String x:Key="Caches.ClearSearch">Wyczyść wyszukiwanie</s:String>
