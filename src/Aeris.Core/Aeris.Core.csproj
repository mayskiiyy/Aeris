<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aeris.Core</AssemblyName>
    <RootNamespace>Aeris</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Languages\*.xaml" LogicalName="Aeris.Languages.%(Filename).xaml" />
    <EmbeddedResource Include="Cleaners/builtin.json" LogicalName="Aeris.Cleaners.builtin.json" />
    <EmbeddedResource Include="Cleaners/linux.json" LogicalName="Aeris.Cleaners.linux.json" />
    <InternalsVisibleTo Include="Aeris.Tests" />
  </ItemGroup>
</Project>
